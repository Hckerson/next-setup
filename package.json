{
    "name": "next-app-starter",
    "version": "0.1.0",
    "description": "Domain-neutral Next.js App Router starter.",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "codemod:extract-hooks": "jiti tools/codemods/run-extract-transport-to-hook.ts",
        "contract": "jiti tools/contract/run-generate-contract.ts",
        "contract:check": "jiti tools/contract/run-generate-contract.ts --check",
        "lint": "eslint",
        "prepare": "git config --unset-all core.hooksPath || exit 0"
    },
    "dependencies": {
        "@gsap/react": "2.1.2",
        "@react-three/drei": "10.7.9",
        "@react-three/fiber": "9.8.2",
        "@tanstack/react-query": "^5.101.2",
        "axios": "^1.18.1",
        "colorjs.io": "0.7.1",
        "date-fns": "^4.4.0",
        "gsap": "3.15.1",
        "jose": "^6.2.12",
        "lenis": "1.3.27",
        "maath": "0.10.8",
        "mediabunny": "1.65.2",
        "motion": "^12.43.0",
        "nanoid": "^6.0.1",
        "next": "16.2.10",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "server-only": "^0.0.1",
        "three": "0.187.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@capsizecss/metrics": "4.4.0",
        "@gltf-transform/cli": "4.5.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "0.187.0",
        "@typescript-eslint/rule-tester": "^8.66.0",
        "@typescript-eslint/utils": "^8.66.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "fast-check": "^4.9.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "stats-gl": "4.2.3",
        "tailwindcss": "^4",
        "ts-morph": "^28.0.0",
        "typescript": "^5",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    }
}
